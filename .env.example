# =============================================================================
# Kalshi Autonomous Trader -- environment configuration
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
# Everything here overrides configs/default.yaml.
#
# There is deliberately NO perpetual leverage setting. The 1.00x ceiling is a
# comparison in packages/kat/risk/invariants.py and cannot be configured.
# =============================================================================

# --- operating mode ----------------------------------------------------------
# full_autonomous | human_strategies | autonomous_discovery | gated_discovery
KAT_OPERATING_MODE=gated_discovery

# paper | demo | live
#   paper -> simulates fills against live market data, sends NO orders
#   demo  -> sends real orders to Kalshi's demo exchange (fake money)
#   live  -> sends real orders with REAL MONEY
KAT_ENVIRONMENT=paper

# Second, independent switch for real money. BOTH this and KAT_ENVIRONMENT=live
# are required before a single live order can be constructed.
KAT_LIVE_TRADING_ARMED=false

# --- Kalshi credentials ------------------------------------------------------
# Create at: Account & security -> API Keys (demo.kalshi.co or kalshi.com).
# Credentials are NOT shared between demo and production.
# Store the .key file OUTSIDE this repository.
KAT_KALSHI__EVENT_CREDENTIALS__API_KEY_ID=
KAT_KALSHI__EVENT_CREDENTIALS__PRIVATE_KEY_PATH=C:/secrets/kalshi/event.key

# Separate identity for perpetuals. Kalshi documents that keys should not be
# shared between the event-contract and margin gateways; separate keys also give
# you separate rate-limit buckets.
KAT_KALSHI__PERP_CREDENTIALS__API_KEY_ID=
KAT_KALSHI__PERP_CREDENTIALS__PRIVATE_KEY_PATH=C:/secrets/kalshi/perp.key

# Read production market data while staying in PAPER.
#
# This is the safest way to see the platform work on real markets. The demo
# exchange quotes 10-97 cent spreads on books that never move, so realised
# volatility is zero and every strategy correctly declines everything. Real
# markets quote 1-2 cents and actually trade.
#
# With environment=paper, orders are impossible regardless of this setting:
# can_submit_real_orders requires KAT_ENVIRONMENT=live AND
# KAT_LIVE_TRADING_ARMED=true, and both are separate from this line. It is
# deliberately restricted to PAPER -- in DEMO the platform really does send
# orders, and it must send them to the exchange it priced them from.
#
# Needs production API keys above (Kalshi does not share credentials between
# demo and production). Those keys can read; they cannot trade while this is
# paper.
KAT_KALSHI__READ_PRODUCTION_MARKET_DATA=false

# --- database ----------------------------------------------------------------
# PostgreSQL (production). TimescaleDB is used automatically when present.
KAT_DATABASE__URL=postgresql+asyncpg://kat:CHANGE_ME@127.0.0.1:5432/kat
# For a first run with no database server, SQLite works:
# KAT_DATABASE__URL=sqlite+aiosqlite:///data/kat.db

# --- dashboard / API ---------------------------------------------------------
# What a PAPER run pretends the account holds, per tradeable domain. Only
# domains that can actually trade are seeded, so with no perpetual credentials
# this is the whole simulated account rather than half of it.
# How often the watchlist is re-chosen. Markets that produced no top-of-book
# change at all during the interval lose their subscription slot to fresh
# candidates: a 24-hour volume figure describes a market's past, and what it did
# while we were watching is the better guide to whether the next half hour is
# worth a slot.
KAT_WATCHLIST_REFRESH_S=1800

KAT_PAPER_STARTING_BALANCE_USD=200

KAT_API_HOST=127.0.0.1
KAT_API_PORT=8000

# Remote access: reaching the dashboard from your phone or another laptop.
#
#   off        loopback only. Nothing outside this machine can reach it.
#   tailscale  also bind this machine's Tailscale address, so your own devices
#              can reach it over WireGuard and nothing else can.
#
# There is no option that binds every interface. The dashboard has no login --
# it can engage kill switches and change risk limits -- so the network is the
# authentication, and any address that is not loopback or Tailscale is refused.
#
# For "tailscale": install Tailscale on this machine and on the device you want
# to use, run `tailscale up` on both, then set this and restart. If Tailscale is
# not running the platform still starts, on loopback, and says so in the log.
KAT_API_REMOTE_ACCESS=off
KAT_LOG_LEVEL=INFO

# --- LLM (optional, local-first) --------------------------------------------
# Defaults target a local OpenAI-compatible server (Ollama / llama.cpp / LM
# Studio). The platform never requires a paid hosted model.
KAT_LLM__ENABLED=false
KAT_LLM__BASE_URL=http://127.0.0.1:11434/v1
KAT_LLM__MODEL=llama3.1:8b
KAT_LLM__API_KEY=

# How stale a *quiet* market's book may be while the feed itself is proven live.
# A different question from the budget above: this is a delta feed, so a market
# that has sent nothing is usually saying the book has not changed, and only
# silence across the whole feed means we may be disconnected. Bounded rather than
# unlimited, because a live feed does not prove one subscription is still live.
KAT_QUIET_MARKET_MAX_AGE_MS=300000
