# --- secrets: never commit ---
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
secrets/
configs/local.yaml
configs/*.local.yaml

# --- python ---
__pycache__/
*.py[cod]
*.so
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
*.egg-info/
build/
dist/

# --- node / dashboard ---
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
apps/dashboard/.env*.local

# --- runtime state (machine-local, not source) ---
# Anchored with a leading slash. A bare `data/` matches at ANY depth, which
# silently excluded the source package packages/kat/data/ from the repository:
# a fresh clone was missing a file the working tree had, and any module added
# there would have been absent from every deployment without a single error.
/logs/
/data/
!/data/.gitkeep
!/logs/.gitkeep
*.db
*.sqlite
*.sqlite3
backups/
artifacts/
mlruns/

# --- editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# local database password written by setup
.db_password

# dashboard build output
apps/dashboard/.next/
apps/dashboard/node_modules/
